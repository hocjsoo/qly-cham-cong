rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Selfie check-in (tùy chọn, mục 10 kiến trúc) — chỉ chủ tài khoản upload, mọi người có role >= leader đọc được
    match /selfies/{employeeId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == employeeId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    // Avatar nhân sự — chỉ Cloud Function (đồng bộ) ghi
    match /avatars/{employeeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // File export báo cáo — chỉ đọc, sinh bởi Cloud Function
    match /exports/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
