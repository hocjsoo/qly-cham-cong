# ==============================================
# ET Office Portal — Environment Variables
# ==============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Các frontend bổ sung, phân cách bằng dấu phẩy (Vercel preview/custom domain)
CORS_ORIGINS=https://qly-cham-cong.vercel.app

# MongoDB Atlas Connection String
# Get yours at: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/et-office?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=change-this-to-a-random-secret-key-at-least-32-chars
JWT_EXPIRES_IN=7d

# Default Office GPS Location (Ho Chi Minh City)
OFFICE_LAT=10.7769
OFFICE_LNG=106.7009
OFFICE_RADIUS_METERS=100

# Initial Admin User Seeding (First-time setup only)
INITIAL_ADMIN_EMAIL=admin@company.com
INITIAL_ADMIN_PASSWORD=ChangeThisPassword123!

# Brevo Transactional Email API — ưu tiên cho Render Free (HTTPS, miễn phí 300 email/ngày)
# Tạo API key tại Brevo và xác minh BREVO_SENDER_EMAIL trước khi sử dụng.
BREVO_API_KEY=xkeysib-your_brevo_api_key
BREVO_SENDER_EMAIL=verified_sender@example.com
BREVO_SENDER_NAME=Kiến trúc ET
# Tùy chọn: nơi nhận phản hồi nếu người dùng bấm Reply
BREVO_REPLY_TO_EMAIL=
BREVO_REPLY_TO_NAME=Kiến trúc ET
BREVO_TIMEOUT_MS=20000
# Logo HTTPS công khai dùng trong email Brevo
EMAIL_LOGO_URL=https://qly-cham-cong.vercel.app/logo.png

# Gmail SMTP — phương án dự phòng khi chạy trên máy chủ cho phép cổng SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FAMILY=4
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM="ET Office Portal" <your_email@gmail.com>
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_GREETING_TIMEOUT_MS=15000
SMTP_SOCKET_TIMEOUT_MS=30000
SMTP_TLS_REJECT_UNAUTHORIZED=true
